# Normalise text files to LF in the repository
* text=auto eol=lf

# Windows-only files keep CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.iss   text eol=crlf
*.reg   text eol=crlf
app/installer/*.txt text eol=crlf

# Real console output with carriage returns: never touch
app/tests/fixtures/** -text

*.png   binary
*.ico   binary
*.ttf   binary
*.mp4   binary
